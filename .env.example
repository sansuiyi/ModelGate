# 合同解析 + 测试台（DeepSeek 直连）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
EXTRACTION_MODEL=deepseek-flash
REACT_MODEL=deepseek-flash
PLAYGROUND_MODEL_SIMPLE=deepseek-flash
PLAYGROUND_MODEL_MEDIUM=deepseek-flash
PLAYGROUND_MODEL_COMPLEX=deepseek-v4-pro
DEEPSEEK_DISABLE_THINKING=true
# 成本估算单价（美元/百万 token），0 表示不估算
DEEPSEEK_INPUT_PRICE_PER_M=0
DEEPSEEK_OUTPUT_PRICE_PER_M=0
# Agent harness 预算
MAX_CONTRACT_CHARS=200000
AGENT_MAX_ITERS=14
AGENT_MAX_TOKENS=80000
AGENT_SOFT_TOKEN_RATIO=0.7
AGENT_MAX_SECONDS=90
AGENT_MAX_OUTPUT_TOKENS=2000
AGENT_MAX_TOOL_CALLS_PER_ROUND=8

# 正式请求代理（OpenRouter/方舟）
OPENROUTER_API_KEY=your-openrouter-api-key-here
